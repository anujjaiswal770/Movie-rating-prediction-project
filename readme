#For testing,we create a new dataframe with values close to the any of our existing data to evaluate.
data={'Year':[2019],'Duration':[111],'Votes':[36],'Genre_Mean_Rating':[5.8],'Director_Mean_Rating':[4.5],'Actor1_Mean_Rating':[5.3],'Actor2_Mean_Rating':[4.5],'Actor3_Mean_Rating':[4.5]}
trail=pd.DataFrame(data)
     

#Predict the movie rating by entered data
rating_predicted = Model.predict(trail.drop(columns=['Votes']))
#Display the predicted result from the Model
print('The predicted rating is:',rating_predicted)
     
