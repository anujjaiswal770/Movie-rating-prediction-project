import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px
     

df_movie=pd.read_csv('/content/IMDb Movies India.csv.zip', sep=',', engine='python', encoding='latin1')
df_movie=df_movie.dropna()
